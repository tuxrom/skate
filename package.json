{
  "name": "skate",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Jeu de skateboard 3D jouable dans le navigateur (PC et mobile), installable en PWA.",
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "icons": "pwa-assets-generator"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tuxrom/skate.git"
  },
  "dependencies": {
